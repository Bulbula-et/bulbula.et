# Copy to .env and adjust locally. Never commit a real .env file.
APP_NAME=Bulbula
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Addis_Ababa

LOG_CHANNEL=bulbula
LOG_PATH=storage/logs/app.log
LOG_LEVEL=debug

# Database. MariaDB in every environment; the suite uses an in-memory SQLite
# database, so these values are not needed to run the tests.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bulbula
DB_USERNAME=bulbula
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

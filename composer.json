{
    "name": "bulbula/bulbula.et",
    "description": "Engineering baseline for Bulbula — a framework-free PHP foundation with testing, static analysis, coding standards, refactoring and mutation testing.",
    "type": "project",
    "keywords": [
        "bulbula",
        "ethiopia",
        "business-discovery",
        "baseline"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Bulbula",
            "email": "bulbula.et@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "monolog/monolog": "^3.9",
        "psr/log": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "infection/infection": "^0.35.6",
        "laravel/pint": "^1.29",
        "nunomaduro/phpinsights": "^2.14",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.1",
        "symfony/var-dumper": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "Bulbula\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "infection/extension-installer": true,
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "serve": "php -S 0.0.0.0:8000 -t public",
        "pint": "./vendor/bin/pint --ansi",
        "rector": "./vendor/bin/rector --ansi",
        "phpstan": "./vendor/bin/phpstan analyse --ansi",
        "phpinsights": "./vendor/bin/phpinsights analyse --ansi --no-interaction --config-path=phpinsights.php src config public",
        "pest": "./vendor/bin/pest --colors=always",
        "pest:parallel": "./vendor/bin/pest --colors=always --parallel --processes=4",
        "pest:profiling": "./vendor/bin/pest --colors=always --profile",
        "pest:coverage": "./vendor/bin/pest --colors=always --coverage --min=100",
        "pest:type-coverage": "./vendor/bin/pest --colors=always --type-coverage --min=100",
        "infection": "./vendor/bin/infection --ansi --threads=max --show-mutations",
        "infection:ci": "./vendor/bin/infection --ansi --threads=max --no-progress --no-interaction --logger-github",
        "test:composer": "composer validate --strict --ansi",
        "test:rector": "./vendor/bin/rector --dry-run --ansi",
        "test:pint": "./vendor/bin/pint --test --ansi",
        "test:insights": "./vendor/bin/phpinsights analyse --ansi --no-interaction --config-path=phpinsights.php src config public",
        "test": [
            "@test:composer",
            "@test:rector",
            "@test:pint",
            "@phpstan",
            "@pest",
            "@pest:type-coverage"
        ],
        "test:all": [
            "@test",
            "@test:insights",
            "@infection"
        ],
        "core:update": [
            "composer validate --strict --ansi",
            "composer update --no-interaction --prefer-stable",
            "composer bump --ansi",
            "composer audit --ansi"
        ]
    },
    "scripts-descriptions": {
        "serve": "Serve the pre-launch page with PHP's built-in web server.",
        "infection": "Run mutation testing (requires pcov or xdebug).",
        "test": "Run every fast quality gate: composer, rector, pint, phpstan, pest, type coverage.",
        "test:all": "Run the fast gates plus PHPInsights and mutation testing."
    }
}

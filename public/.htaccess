# Apache front-controller rules for the document root.
#
# The document root must be this directory. index.php is the only entry
# point: existing files (assets) are served directly, everything else is
# handed to the application router with the original URI intact.
#
# Keep this file to directives the FileInfo and Indexes override classes
# allow. An "Options" directive is rejected on hosts whose vhost does not
# grant that override (cPanel/EA4 commonly does not), and Apache then fails
# the whole directory with "not allowed here" - every URL, including static
# assets, answers 500 before PHP ever runs. Disable directory listings in
# the hosting panel instead.

# The PHP handler below is the block cPanel's MultiPHP Manager writes into
# this file. It has to be tracked: the deployment resets the working tree to
# origin/main, which deletes anything cPanel added here, and the request then
# falls back to the system interpreter - PHP 8.2 - which cannot even parse
# this codebase. Change the version here, not only in the panel.

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php84" package as the default "PHP" programming language.
<IfModule mime_module>
    AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
